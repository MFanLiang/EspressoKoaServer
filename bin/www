#!/usr/bin/env node

/**
 * Module dependencies.
 */

const path = require("path");
var app = require('../app');
var debug = require('debug')('demo:server');
var http = require('http');
const https = require("https");
const fs = require('fs');
var { getLocalIP } = require('./../utils/index');

/**
 * Get port from environment and store in Express.
 */

/** http 服务端口 */
var port_http = normalizePort(process.env.PORT || '5050');

/** https 服务端口 */
var port_https = normalizePort(process.env.PORT_HTTPS || '443');

/**
 * Create HTTP server.
 */
var server = http.createServer(app.callback());

/**
 * Listen on provided port, on all network interfaces.
 */
server.listen(port_http, () => {
  console.log(`The service is running at ${process.env.NODE_ENV === "development" ? getLocalIP() || process.env.HOST_IPADDRESS : process.env.HOST_IPADDRESS}:${port_http}.`);
  console.log(`→ Local: http://localhost:${port_http}.`)
  console.log(`→ Network: http://${process.env.NODE_ENV === "development" ? getLocalIP() || process.env.HOST_IPADDRESS : process.env.HOST_IPADDRESS}:${port_http}.`)
});
server.on('error', onError);
server.on('listening', onListening);

// 读取证书和私钥文件
const options = {
  key: fs.readFileSync(path.join(__dirname, '../cert/private.key')), // 私钥
  cert: fs.readFileSync(path.join(__dirname, '../cert/certificate.crt')) // 证书
};

/**
 * Create HTTPS server.
 */
var server_https = https.createServer(options, app.callback());

server_https.listen(port_https, () => {
  console.log(`The https service is running, starting on port https://${process.env.NODE_ENV === "development" ? getLocalIP() || process.env.HOST_IPADDRESS : process.env.HOST_IPADDRESS}:${port_https}.`);
});

server_https.on('error', onError);
server_https.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort (val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError (error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // * handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening () {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}

module.exports = { port_http, port_https };
